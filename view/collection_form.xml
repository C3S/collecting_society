<form col="4">
    <label name="start"/>
    <group col="-1" colspan="1" id="start">
        <field name="start" widget="date"/>
        <field name="start" widget="time"/>
    </group>
    <label name="entity_origin"/>
    <field name="entity_origin"/>

    <label name="end"/>
    <group col="-1" colspan="1" id="end">
        <field name="end" widget="date"/>
        <field name="end" widget="time"/>
    </group>
    <label name="entity_creator"/>
    <field name="entity_creator"/>

    <label name="uuid"/>
    <field name="uuid"/>
    <label name="invoice_amount"/>
    <field name="invoice_amount"/>

    <label name="code"/>
    <field name="code"/>

    <newline/>
    <notebook colspan="4">
        <page string="Total" id="allocations">
            <field name="allocations"/>
        </page>
        <page string="Processing" id="allocations_processing">
            <field name="allocations_processing"/>
        </page>
        <page string="Unposted" id="allocations_unposted">
            <field name="allocations_unposted"/>
        </page>
        <page string="Posted" id="allocations_posted">
            <field name="allocations_posted"/>
        </page>
        <page string="Paid" id="allocations_paid">
            <field name="allocations_paid"/>
        </page>
        <page string="Distributed" id="allocations_distributed">
            <field name="allocations_distributed"/>
        </page>
        <page string="Utilisations" id="utilisations">
            <field name="utilisations"/>
        </page>
        <page string="Invoices" id="invoices">
            <field name="invoices"/>
        </page>
    </notebook>
</form>
