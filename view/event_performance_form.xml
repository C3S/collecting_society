<form col="6">
    <label name="event"/>
    <field name="event"/>
    <label name="artist"/>
    <field name="artist"/>

    <group col="20" colspan="2" id="checkboxes">
        <label name="active"/>
        <field name="active" xexpand="0" width="25"/>
    </group>

    <label name="start"/>
    <group col="2" colspan="1" id="start">
        <field name="start" widget="date"/>
        <field name="start" widget="time"/>
    </group>
    <label name="playlist"/>
    <field name="playlist"/>

    <newline/>

    <label name="end"/>
    <group col="2" colspan="1" id="end">
        <field name="end" widget="date"/>
        <field name="end" widget="time"/>
    </group>
</form>